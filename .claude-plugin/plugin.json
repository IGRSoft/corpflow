{
  "name": "corpflow",
  "description": "Staged worktask pipeline (PL→AR→TL→DV→DR→SR→QA→DC→RE→FN→ST) with a durable state ledger, cross-plugin delegation, and /megatask dependency-DAG orchestration of many worktasks across a GitHub milestone.",
  "version": "4.0.25",
  "author": {
    "name": "IGRSoft",
    "email": "support@igrsoft.com"
  },
  "keywords": [
    "worktask",
    "task-management",
    "state-ledger",
    "stage-contracts",
    "approval-gates",
    "agent-orchestration",
    "megatask",
    "dependency-dag",
    "project-management",
    "developer-review",
    "security-review",
    "qa-testing",
    "release-engineering",
    "incident-response",
    "self-improvement"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Skill|Task|mcp__.*test.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/test-execution-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": [
              "--kind",
              "tool"
            ],
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/anchor-preflight.sh",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/comment-standard-context.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dv-screenshot-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dv-comment-density-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/state-merge.sh",
            "continueOnBlock": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/megatask-monitor.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*corpflow:product-manager.*|.*corpflow:project-manager.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "conductor",
            "tool": "PushNotification",
            "args": {
              "title": "corpflow worktask",
              "message": "Approval gate ready for review"
            }
          }
        ]
      }
    ]
  }
}
