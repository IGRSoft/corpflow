{
  "name": "igrsoft",
  "description": "Comprehensive 11-stage workflow system (PL→AR→TL→DV→DR→SR→QA→DC→RE→FN→ST) for task management with Task System integration, developer review, security review, release engineering, incident response, and ST-stage self-improvement retrospectives.",
  "version": "3.10.7",
  "author": {
    "name": "IGRSoft",
    "email": "support@igrsoft.com"
  },
  "keywords": [
    "workflow",
    "task-management",
    "task-system",
    "project-management",
    "agile",
    "stages",
    "approval-gates",
    "product-management",
    "architecture",
    "qa-testing",
    "documentation",
    "ethics-review",
    "prompt-engineering",
    "design-systems",
    "cost-optimization",
    "estimation",
    "security-review",
    "release-engineering",
    "incident-response",
    "cross-plugin-handoff",
    "tool-restrictions",
    "agent-teams",
    "hooks",
    "subagent-lifecycle",
    "ultrathink",
    "context-efficiency",
    "http-hooks",
    "1m-context",
    "post-compact-hook",
    "mcp-elicitation",
    "worktree-sparse",
    "exit-worktree",
    "monitor-tool",
    "focus-mode",
    "effort-default-high",
    "ca-certificates",
    "keep-coding-instructions",
    "skill-frontmatter-name",
    "mcp-dynamic-inherit",
    "settings-resilience",
    "opus-4-7",
    "xhigh-effort",
    "pre-compact-hook",
    "enter-worktree-path",
    "plugin-monitors",
    "prompt-caching-1h",
    "subagent-stall-timeout",
    "context-logs-convention",
    "per-agent-error-files",
    "stage-contracts",
    "metadata-json-schema",
    "error-decision-tree",
    "cost-tracking-hook",
    "audit-trail",
    "resume-protocol",
    "approval-gate-hook",
    "state-machine-diagram",
    "ethics-gate-autodetect",
    "postcompact-recovery",
    "ir-dv-contract",
    "self-improvement",
    "st-retrospective",
    "diff-based-learning",
    "skip-exploration-flag",
    "anchor-pre-flight",
    "fallback-telemetry",
    "effort-budget-matrix",
    "test-selection-gate",
    "selective-retest",
    "hook-authored-audit",
    "precompact-checkpoint",
    "mcp-tool-hooks",
    "push-notification-gates",
    "state-merge-hook",
    "three-layer-enforcement",
    "filename-lint",
    "token-optimization",
    "read-once-protocol",
    "edit-batch-build",
    "mcp-session-cache"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "TaskUpdate|TaskCreate|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": ["--kind", "tool"],
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/hooks/state-merge.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "igrsoft:product-manager|igrsoft:project-manager",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "conductor",
            "tool": "PushNotification",
            "args": {
              "title": "igrsoft workflow",
              "message": "Approval gate ready for review"
            }
          }
        ]
      }
    ]
  }
}
