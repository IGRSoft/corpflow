.context/images/*/oversize/

# Swift Package Manager build artifacts (template examples should not commit them)
.build/
.swiftpm/
Package.resolved
__pycache__
*.pyc
*.pyo

# benchmark: per-run generated apps + scratch (gitignored per AC-9; history.json is TRACKED)
benchmark/workdirs/
# Deterministic detail records are free to reproduce, so they stay untracked.
# Live records are NOT ignored: each costs real spend and is the only evidence of
# the run that produced it — every findings doc cites them as its data source.
benchmark/results/runs/deterministic/
!benchmark/results/runs/.gitkeep

# kcov coverage output
.coverage-kcov/
