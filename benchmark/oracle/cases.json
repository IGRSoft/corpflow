      "args": [
        "--moves",
        "0, 4, 1"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | X | 2 \n---+---+---\n 3 | O | 5 \n---+---+---\n 6 | 7 | 8 \nresult: in_progress\n"
      },
      "tier": "specified"
    },
    {
      "id": "reject-occupied-cell",
      "description": "replaying an occupied cell is rejected",
      "args": [
        "--moves",
        "0,0"
      ],
      "expect": {
        "exit_code": 1,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "reject-out-of-range-high",
      "description": "a cell index above 8 is rejected",
      "args": [
        "--moves",
        "0,9"
      ],
      "expect": {
        "exit_code": 1,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "reject-out-of-range-negative",
      "description": "a negative cell index is rejected",
      "args": [
        "--moves",
        "0,-1"
      ],
      "expect": {
        "exit_code": 1,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "reject-malformed-token",
      "description": "non-numeric move tokens are malformed argv",
      "args": [
        "--moves",
        "a,b"
      ],
      "expect": {
        "exit_code": 2,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "reject-float-token",
      "description": "fractional move tokens are malformed argv",
      "args": [
        "--moves",
        "0,1.5"
      ],
      "expect": {
        "exit_code": 2,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "x-wins-on-final-cell",
      "description": "X completes a line with the last cell: a full board is not automatically a draw",
      "args": [
        "--moves",
        "2,0,4,3,1,7,5,8,6"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " O | X | X \n---+---+---\n O | X | X \n---+---+---\n X | O | O \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "o-wins-top-row",
      "description": "O completes the top row",
      "args": [
        "--moves",
        "4,0,3,1,6,2"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " O | O | O \n---+---+---\n X | X | 5 \n---+---+---\n X | 7 | 8 \nresult: O_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "o-wins-anti-diagonal",
      "description": "O completes the top-right/bottom-left diagonal",
      "args": [
        "--moves",
        "0,2,1,4,3,6"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | X | O \n---+---+---\n X | O | 5 \n---+---+---\n O | 7 | 8 \nresult: O_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "reject-out-of-range-first-move",
      "description": "the very first move can be out of range",
      "args": [
        "--moves",
        "9"
      ],
      "expect": {
        "exit_code": 1,
        "stdout": ""
      },
      "tier": "specified"
    },
    {
      "id": "after-win-occupied-move-ignored",
      "description": "a move onto an occupied cell after the win is never played, so never rejected",
      "args": [
        "--moves",
        "0,3,1,4,2,0"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | X | X \n---+---+---\n O | O | 5 \n---+---+---\n 6 | 7 | 8 \nresult: X_wins\n"
      },
      "tier": "implied"
    },
    {
      "id": "after-win-out-of-range-move-ignored",
      "description": "an out-of-range move after the win is never played, so never rejected",
      "args": [
        "--moves",
        "0,3,1,4,2,99"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | X | X \n---+---+---\n O | O | 5 \n---+---+---\n 6 | 7 | 8 \nresult: X_wins\n"
      },
      "tier": "implied"
    },
    {
      "id": "after-draw-extra-move-ignored",
      "description": "a move after the draw is never played, so never rejected",
      "args": [
        "--moves",
        "0,1,2,4,3,5,7,6,8,0"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | O | X \n---+---+---\n X | O | O \n---+---+---\n O | X | X \nresult: draw\n"
      },
      "tier": "implied"
    },
    {
      "id": "malformed-token-outranks-early-stop",
      "description": "--moves is parsed whole before play, so a bad token loses to no early stop",
      "args": [
        "--moves",
