      },
      "tier": "specified"
    },
    {
      "id": "x-wins-anti-diagonal",
      "description": "X completes the top-right/bottom-left diagonal",
      "args": [
        "--moves",
        "2,0,4,1,6"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " O | O | X \n---+---+---\n 3 | X | 5 \n---+---+---\n X | 7 | 8 \nresult: X_wins\n"
