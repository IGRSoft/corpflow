        "stdout": " O | X | X \n---+---+---\n 3 | O | 5 \n---+---+---\n 6 | X | O \nresult: O_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "draw-full-board",
      "description": "a full board with no line is a draw",
      "args": [
        "--moves",
        "0,1,2,4,3,5,7,6,8"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | O | X \n---+---+---\n X | O | O \n---+---+---\n O | X | X \nresult: draw\n"
      },
      "tier": "specified"
    },
    {
      "id": "moves-after-win-ignored",
      "description": "play stops at the terminal state; later moves are dropped",
      "args": [
        "--moves",
        "0,3,1,4,2,5,6"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | X | X \n---+---+---\n O | O | 5 \n---+---+---\n 6 | 7 | 8 \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
