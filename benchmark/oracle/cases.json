        "exit_code": 0,
        "stdout": " O | O | 2 \n---+---+---\n X | X | X \n---+---+---\n 6 | 7 | 8 \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "x-wins-bottom-row",
      "description": "X completes the bottom row",
      "args": [
        "--moves",
        "6,0,7,1,8"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " O | O | 2 \n---+---+---\n 3 | 4 | 5 \n---+---+---\n X | X | X \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "x-wins-left-column",
      "description": "X completes the left column",
      "args": [
        "--moves",
        "0,1,3,4,6"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " X | O | 2 \n---+---+---\n X | O | 5 \n---+---+---\n X | 7 | 8 \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "x-wins-middle-column",
      "description": "X completes the middle column",
      "args": [
        "--moves",
        "1,0,4,2,7"
      ],
      "expect": {
        "exit_code": 0,
        "stdout": " O | X | O \n---+---+---\n 3 | X | 5 \n---+---+---\n 6 | X | 8 \nresult: X_wins\n"
      },
      "tier": "specified"
    },
    {
      "id": "x-wins-right-column",
