      ],
      "expect": {
        "exit_code": 2,
        "stdout": ""
      },
      "tier": "implied"
    },
    {
      "id": "invalid-move-outranks-later-win",
      "description": "play halts on the invalid move; the win it would have reached never happens",
      "args": [
        "--moves",
