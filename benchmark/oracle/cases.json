  "tiers": {
    "specified": "behaviour the shared stage prompt enumerates; a failure is non-conformance with the contract the arm was handed",
    "implied": "behaviour the contract's own rules determine but do not spell out; a failure is a gap in reasoning from the spec, not non-conformance"
  }
